        "def main():\n",
        "  lst = []\n",
        "\n",
        "  val = input(\"Enter a value: \")\n",
        "  while val != \"\":\n",
        "    lst.append(val)\n",
        "    val = input(\"Enter a value: \")\n",
        "\n",
        "  print(\"Here's the list:\", lst)\n",
        "\n",
        "main()\n"
