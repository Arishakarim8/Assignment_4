        "def sum():\n",
        "  numbers : list[int] = [1 , 2 , 3 , 4]\n",
        "  for i in range(len(numbers)):\n",
        "    elem_in_index = numbers[i]\n",
        "    numbers[i] = elem_in_index * 2\n",
        "\n",
