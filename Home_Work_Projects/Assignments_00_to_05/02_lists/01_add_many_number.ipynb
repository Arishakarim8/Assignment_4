      "source": [
        "def add_many_numbers(numbers) -> int :\n",
        "\n",
        "  total_so_far : int = 0\n",
        "  for number in numbers:\n",
        "    total_so_far += number\n",
        "\n",
        "  return total_so_far\n",
        "\n",
        "def main():\n",
        "  numbers : list[int] = [ 1 , 2 , 3 , 4 , 5 , 6]\n",
        "  sums_of_numbers = add_many_numbers(numbers)\n",
        "  print(sums_of_numbers)\n",
        "\n",
        "main()\n"
      ]
    }
  ]
