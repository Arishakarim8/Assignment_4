        "def add_three_copies(my_list , data):\n",
        "  for i in range(3):\n",
        "    my_list.append(data)\n",
        "\n",
        "def main():\n",
        "  message = input(\"Enter a message to copy: \")\n",
        "  my_list = []\n",
        "  print(\"List before:\", my_list)\n",
        "  add_three_copies(my_list, message)\n",
        "  print(my_list)\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "  main()\n"
