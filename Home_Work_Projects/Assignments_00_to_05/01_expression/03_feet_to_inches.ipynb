      "source": [
        "INCHES_IN_FEET : int = 12\n",
        "\n",
        "def main():\n",
        "    feet : int = int(input(\"Enter number of feet: \"))\n",
        "    inches : int = feet * INCHES_IN_FEET\n",
        "    print(f\"{feet} feet is equal to {inches} inches.\")\n",
        "\n",
        "main()"
      ]
